{
  "location": "francecentral",
  "tags": {
    "project": "pv-anomaly-detection",
    "purpose": "academic-evaluation"
  },
  "properties": {
    "managedEnvironmentId": "/subscriptions/38a91a22-90a0-45e3-aad6-ce69bf22ed3a/resourceGroups/rg-pv-anomaly-detection/providers/Microsoft.App/managedEnvironments/pv-anomaly-env",
    "workloadProfileName": "Consumption",
    "configuration": {
      "activeRevisionsMode": "Single",
      "ingress": {
        "external": true,
        "targetPort": 8000,
        "allowInsecure": false,
        "transport": "auto"
      },
      "secrets": []
    },
    "template": {
      "revisionSuffix": "cors-cf295ed",
      "containers": [
        {
          "name": "pv-inference",
          "image": "ghcr.io/ruganji-prince/pv-anomaly-detection@sha256:234cba831be3b1465a8447c16922602dc54f5f0dcb3a86cc5b465c0890e5023f",
          "resources": {
            "cpu": 0.5,
            "memory": "1Gi"
          },
          "env": [
            {
              "name": "PYTHONDONTWRITEBYTECODE",
              "value": "1"
            },
            {
              "name": "PYTHONUNBUFFERED",
              "value": "1"
            },
            {
              "name": "PV_FRONTEND_ORIGINS",
              "value": "[\"https://pv-anomaly-detection-prince-r-k.vercel.app\",\"https://pv-anomaly-detection-vert.vercel.app\",\"https://pv-anomaly-detection-pbyhom77a-prince-r-k.vercel.app\",\"http://localhost:8080\",\"http://127.0.0.1:8080\"]"
            }
          ],
          "probes": [
            {
              "type": "Startup",
              "httpGet": {
                "path": "/api/health",
                "port": 8000,
                "scheme": "HTTP"
              },
              "initialDelaySeconds": 10,
              "periodSeconds": 5,
              "timeoutSeconds": 5,
              "failureThreshold": 24,
              "successThreshold": 1
            },
            {
              "type": "Readiness",
              "httpGet": {
                "path": "/api/health",
                "port": 8000,
                "scheme": "HTTP"
              },
              "initialDelaySeconds": 5,
              "periodSeconds": 10,
              "timeoutSeconds": 5,
              "failureThreshold": 3,
              "successThreshold": 1
            },
            {
              "type": "Liveness",
              "tcpSocket": {
                "port": 8000
              },
              "initialDelaySeconds": 30,
              "periodSeconds": 30,
              "timeoutSeconds": 5,
              "failureThreshold": 3,
              "successThreshold": 1
            }
          ]
        }
      ],
      "scale": {
        "minReplicas": 0,
        "maxReplicas": 1,
        "cooldownPeriod": 300,
        "pollingInterval": 30,
        "rules": [
          {
            "name": "http-requests",
            "http": {
              "metadata": {
                "concurrentRequests": "2"
              }
            }
          }
        ]
      }
    }
  }
}
